{
  "manifest_version": 3,
  "name": "CONTEXTO",
  "version": "1.1.3",
  "description": "Painel de anotações ao lado das conversas do WhatsApp Web: resumo, demandas e histórico por cliente.",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "src/storage.js",
        "src/model.js",
        "src/detector.js",
        "src/styles.js",
        "src/ui.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
